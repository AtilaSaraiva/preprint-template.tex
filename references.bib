@article{holland_finite-difference_1994,
	title = {Finite-difference time-domain ({FDTD}) analysis of magnetic diffusion},
	volume = {36},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
	issn = {00189375},
	url = {http://ieeexplore.ieee.org/document/265477/},
	doi = {10.1109/15.265477},
	abstract = {Problems with very slow waveforms or very long diffusion times may be difficult to treat using finite-difference time-domain techniques because of the Courant stability condition. Problems of this class, however, often prove to have a response which does not depend on the speed of light. The examples presented here show cases where internal fields do not change if c is reduced by as much as five orders of magnitude. This permits At to be proportionally increased. For simplicity much of this paper is restricted to one dimension, although generalization to three dimensions is also presented.},
	language = {en},
	number = {1},
	urldate = {2025-01-24},
